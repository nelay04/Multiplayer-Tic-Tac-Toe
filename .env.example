# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tic_tac_toe?retryWrites=true&w=majority

# Server port (optional, defaults to 3000)
PORT=3000

# Set to "production" when serving the built frontend
NODE_ENV=development

# 32-byte key used to encrypt chat messages at rest (64 hex characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_ENCRYPTION_KEY=
